{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "The Mezzanine",
    "version": "0.3.1",
    "identifier": "nl.zmuuzn.mezzanine",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1430",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "label": "main",
                "title": "The Mezzanine",
                "width": 1440,
                "height": 900,
                "minWidth": 1080,
                "minHeight": 720,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "transparent": false,
                "visible": true,
                "skipTaskbar": false,
                "center": true,
                "url": "index.html"
            }
        ],
        "security": {"csp": null}
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/goosterhof/mezzanine/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFRUE5MTEyNUQzNTQ4MzAKUldRd1NEVmRFcEhxM2c1Vi9QNStmMktiTFU0eGc5YU9jZ3Z1MkpBdmZENUtvV1RNc0NDNkt6SFMK"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["msi", "nsis"],
        "createUpdaterArtifacts": true,
        "publisher": "Zmuuzn Laboratory",
        "category": "DeveloperTool",
        "shortDescription": "The balcony for the Mad Scientist and the Heretic",
        "longDescription": "The Mezzanine opens two named laboratory colleagues: the Mad Scientist (Claude) and the Heretic (Codex). Switch between their terminals, send briefs, watch their work on the ink floor, and follow their private Speaking Tube connection from one command balcony.",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
        "windows": {
            "wix": {"language": "en-US"},
            "nsis": {"displayLanguageSelector": false, "installerIcon": "icons/icon.ico"}
        }
    }
}
