{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "The Mezzanine",
    "version": "0.2.4",
    "identifier": "nl.zmuuzn.mezzanine",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1430",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "label": "main",
                "title": "The Mezzanine",
                "width": 1440,
                "height": 900,
                "minWidth": 1080,
                "minHeight": 720,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "transparent": false,
                "visible": true,
                "skipTaskbar": false,
                "center": true,
                "url": "index.html"
            }
        ],
        "security": {"csp": null}
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/goosterhof/mezzanine/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFRUE5MTEyNUQzNTQ4MzAKUldRd1NEVmRFcEhxM2c1Vi9QNStmMktiTFU0eGc5YU9jZ3Z1MkpBdmZENUtvV1RNc0NDNkt6SFMK"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["msi", "nsis"],
        "createUpdaterArtifacts": true,
        "publisher": "Zmuuzn Laboratory",
        "category": "DeveloperTool",
        "shortDescription": "The balcony overlooking the lab floor — dispatch mad scientists onto missions",
        "longDescription": "The Mezzanine is the investor's command balcony. The lab floor stretches out below — six experiments, five gadgets, the shared packages, the lab itself. From the balcony, the investor dispatches mad scientists onto missions: each scientist a persistent claude pty, each mission a brief either from the curated Briefing Library or written free-form. The Roster shows who's out and on what. No tabs, no benches — one elevated view of the work in flight.",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
        "windows": {
            "wix": {"language": "en-US"},
            "nsis": {"displayLanguageSelector": false, "installerIcon": "icons/icon.ico"}
        }
    }
}
