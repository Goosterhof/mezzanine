{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capabilities for the Workbench's main window — pty subprocess hosting, lab file reads, Tauri store, http for gh API enrichment.",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "core:window:allow-show",
        "core:window:allow-hide",
        "core:window:allow-set-focus",
        "core:window:allow-close",
        "core:event:default",
        "opener:default",
        "shell:default",
        "store:default",
        "http:default",
        "log:default",
        "dialog:default",
        "fs:default",
        "fs:allow-read-text-file",
        "fs:allow-write-text-file",
        "fs:allow-mkdir",
        "fs:allow-exists"
    ]
}
