{
    "name": "mezzanine",
    "version": "0.1.0",
    "private": true,
    "description": "The Mezzanine — the balcony overlooking the lab floor. Dispatch mad scientists onto missions: each scientist a persistent claude pty, each mission a brief from the Briefing Library or written free-form.",
    "type": "module",
    "scripts": {
        "build": "vue-tsc --noEmit && vite build",
        "dev": "vite",
        "format": "oxfmt --write src tests",
        "format:check": "oxfmt --check src tests",
        "lint": "oxlint --type-aware",
        "preview": "vite preview",
        "tauri": "tauri",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-dialog": "^2",
        "@tauri-apps/plugin-fs": "^2",
        "@tauri-apps/plugin-http": "^2",
        "@tauri-apps/plugin-log": "^2",
        "@tauri-apps/plugin-opener": "^2",
        "@tauri-apps/plugin-shell": "^2",
        "@tauri-apps/plugin-store": "^2",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2",
        "@unocss/preset-attributify": "^66.6.0",
        "@unocss/preset-icons": "^66.6.0",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vitest/coverage-v8": "^2.1.9",
        "@vue/test-utils": "^2.4.6",
        "jsdom": "^25.0.1",
        "oxfmt": "^0.46.0",
        "oxlint": "^1.68.0",
        "oxlint-tsgolint": "^0.22.1",
        "typescript": "~5.6.2",
        "unocss": "^66.6.0",
        "vite": "^6.0.3",
        "vitest": "^2.1.8",
        "vue-tsc": "^2.1.10"
    }
}
