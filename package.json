{
    "name": "mezzanine",
    "version": "0.5.0",
    "private": true,
    "description": "The Mezzanine — one Mad Scientist, one Heretic, and the Speaking Tube on the laboratory balcony.",
    "type": "module",
    "scripts": {
        "build": "vue-tsc --noEmit && vite build",
        "dev": "vite",
        "format": "oxfmt --write src tests",
        "format:check": "oxfmt --check src tests",
        "lint": "oxlint --type-aware",
        "preview": "vite preview",
        "tauri": "tauri",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "vue-tsc --noEmit",
        "version:bump": "node scripts/version.mjs bump",
        "version:check": "node scripts/version.mjs check"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.12.3",
        "@tauri-apps/plugin-dialog": "^2",
        "@tauri-apps/plugin-fs": "^2.7.0",
        "@tauri-apps/plugin-http": "^2",
        "@tauri-apps/plugin-log": "^2",
        "@tauri-apps/plugin-opener": "^2",
        "@tauri-apps/plugin-process": "^2",
        "@tauri-apps/plugin-shell": "^2.5.0",
        "@tauri-apps/plugin-store": "^2",
        "@tauri-apps/plugin-updater": "^2",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-web-links": "^0.12.0",
        "@xterm/xterm": "^6.0.0",
        "highlight.js": "^11.12.0",
        "markdown-it": "^15.0.2",
        "vue": "^3.5.43"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12.2",
        "@types/markdown-it": "^14.2.0",
        "@unocss/preset-attributify": "^66.10.2",
        "@unocss/preset-icons": "^66.11.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "^5.0.3",
        "@vue/test-utils": "^2.5.1",
        "jsdom": "^30.1.1",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "typescript": "~6.0.3",
        "unocss": "^66.10.5",
        "vite": "^8.3.4",
        "vitest": "^5.0.1",
        "vue-tsc": "^3.3.13"
    }
}
